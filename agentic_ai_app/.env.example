# Agentic AI Application Configuration
# Copy this file to .env and fill in your actual values

# Application Settings
DEBUG=false

# OpenAI API (Required for AI functionality)
OPENAI_API_KEY=your_openai_api_key_here

# Meeting Integration (Optional - for Zoom/Teams)
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=your_microsoft_tenant_id

# Jira Integration (Optional)
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_USERNAME=your_jira_email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJ

# Git Integration (Optional)
GITHUB_TOKEN=your_github_personal_access_token
GITLAB_TOKEN=your_gitlab_access_token

# Deployment Configuration (Optional)
DOCKER_REGISTRY=docker.io
KUBERNETES_CONFIG_PATH=/path/to/kubeconfig
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Database (Optional - defaults to SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_ai

# Redis (Optional - for task queue)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production

# Paths
MEETING_RECORDINGS_PATH=./recordings
CODE_OUTPUT_PATH=./generated_code

# Agent Configuration
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT_MINUTES=30

# LLM Configuration
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000